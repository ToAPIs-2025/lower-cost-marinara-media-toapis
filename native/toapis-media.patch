+import { expect, test } from "@playwright/test";
+import { seedUIState } from "./ui-state-fixture.js";
+import { chatSettingsDrawer, openChatSettingsTool } from "./chat-settings-tools.js";
+
+test("Roleplay can animate an existing image without Illustrator when a video connection is configured", async ({
+  page,
+  request,
+}) => {
+  const videoResponse = await request.post("/api/connections/", {
+    data: {
+      name: "ToAPIs visibility fixture",
+      provider: "video_generation",
+      baseUrl: "https://toapis.cn/v1",
+      apiKey: "fixture-only-not-a-real-key",
+      model: "seedance-2-mini",
+      videoService: "seedance",
+      videoGenerationSource: "seedance",
+    },
+  });
+  expect(videoResponse.ok()).toBeTruthy();
+  const connection = await videoResponse.json();
+  const chatResponse = await request.post("/api/chats", {
+    data: { name: "Roleplay media visibility", mode: "roleplay", characterIds: [] },
+  });
+  expect(chatResponse.ok()).toBeTruthy();
+  const chat = await chatResponse.json();
+  const png = Buffer.from(
+    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
+    "base64",
+  );
+  await request.post(`/api/gallery/${chat.id}/upload`, {
+    multipart: { file: { name: "fixture.png", mimeType: "image/png", buffer: png } },
+  });
+  await request.patch(`/api/chats/${chat.id}/metadata`, {
+    data: { sceneVideoConnectionId: connection.id, enableAgents: false, activeAgentIds: [] },
+  });
+  // Verify the condition with no installed agent, without calling any media API.
+  await page.route("**/api/capability-packages/installed", (route) => route.fulfill({ json: [] }));
+  await page.route("**/api/capability-packages/agents", (route) => route.fulfill({ json: [] }));
+  await seedUIState(page, {
+    hasCompletedOnboarding: true,
+    chatHelpSeenModes: ["roleplay"],
+    rightPanelOpen: false,
+    sidebarOpen: false,
+  });
+  await page.addInitScript((id: string) => {
+    localStorage.setItem("marinara-active-chat-id", id);
+    localStorage.setItem("marinara:whats-new:seen-version", "2.5.1");
+  }, chat.id);
+  try {
+    await page.goto("/");
+    await openChatSettingsTool(page, "gallery");
+    const gallery = chatSettingsDrawer(page, "gallery");
+    await expect(gallery.getByRole("button", { name: "Video", exact: true })).toBeVisible();
+    await expect(gallery.getByRole("button", { name: "Animate gallery illustration", exact: true })).toHaveCount(1);
+    await expect(gallery.getByRole("button", { name: "Illustrate", exact: true })).toHaveCount(0);
+    await request.patch(`/api/chats/${chat.id}/metadata`, { data: { sceneVideoConnectionId: null } });
+    await page.reload();
+    await openChatSettingsTool(page, "gallery");
+    await expect(gallery.getByRole("button", { name: "Video", exact: true })).toHaveCount(0);
+    await expect(gallery.getByRole("button", { name: "Animate gallery illustration", exact: true })).toHaveCount(0);
+  } finally {
+    await request.delete(`/api/chats/${chat.id}`);
+    await request.delete(`/api/connections/${connection.id}`);
+  }
+});
